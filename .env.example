# ========== 服务配置 ==========
HOST=0.0.0.0
PORT=8000

# ========== API 鉴权 ==========
# 所有请求需携带 Header: X-API-Key: <此值>
API_KEY=change-me-please

# ========== 美团酒旅 Skill ==========
# 前往 https://developer.meituan.com/zh/v2/dev/token 申请
MEITUAN_HT_TOKEN=your-meituan-ht-token

# ========== 美团跑腿 Skill ==========
# passport token（美团用户登录态），可选；也可由调用方通过 X-Access-Token 动态传入
MCP_ACCESS_TOKEN=
MEITUAN_PAOTUI_SOURCE_FROM=aihub

# ========== 领券 Skill ==========
# 执行 auth.py / issue.py 的 Python 解释器路径，默认用系统 python
COUPON_PYTHON=python

# ========== 超时配置（秒） ==========
TRAVEL_TIMEOUT=180
PAOTUI_TIMEOUT=60
COUPON_TIMEOUT=60
